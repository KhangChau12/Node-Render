# Copy this file to .env.local (repo root) and fill in the values. NEVER commit .env.local.

# ── LLM ────────────────────────────────────────────────
# "openai" (default) or "mock". Without OPENAI_API_KEY the app falls back to mock,
# which returns canned content so you can try the whole flow offline.
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Model per task (any OpenAI model id you have access to)
MODEL_LESSON=gpt-6.1-terra
MODEL_SCRIPT=gpt-6.1-terra
MODEL_CODEGEN=gpt-6.1-terra
MODEL_QUICK_EDIT=gpt-6.1-terra
# Looks at screenshots of each scene and reports layout problems (needs a vision model)
MODEL_REVIEW=gpt-6.1-terra

# Reasoning effort per task: low | medium | high | xhigh | max
# (GPT-5 models also take "minimal"; "none" is dropped by the AI SDK for GPT-6.x)
REASONING_LESSON=medium
REASONING_SCRIPT=medium
REASONING_CODEGEN=high
REASONING_QUICK_EDIT=low
REASONING_REVIEW=low
# Stream the model's reasoning summary into the UI. Needs a verified OpenAI
# organization; the app switches it off automatically if refused. "off" to disable.
REASONING_SUMMARY=auto

# ── DeepSeek via SoCLaaS (NUS SoC gateway) ─────────────
# Each project picks OpenAI or DeepSeek when it is created. DeepSeek needs a
# SoCLaaS key; without it the option is disabled.
SOCLAAS_API_KEY=
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# Model id on the gateway. "x-test-2" is DeepSeek V4.1 Flash, a trial slot the
# gateway may swap out; change it here if that happens. Per task: DEEPSEEK_MODEL_CODEGEN, …
DEEPSEEK_MODEL=x-test-2
# Reasoning for DeepSeek: none | low | high | max. Unset = mapped from REASONING_*.
# DEEPSEEK_REASONING_CODEGEN=high
# Network path. Inside the NUS network the gateway is reached directly; outside,
# through a TCP relay (TLS stays end-to-end, no hosts file edit needed).
#   auto   = try direct, switch to the relay when unreachable (default)
#   always = relay only · off = direct only
SOCLAAS_RELAY=auto
# SOCLAAS_RELAY_IP=13.212.116.159

# ── Storage ────────────────────────────────────────────
# Projects, generated scene code and renders. Relative paths resolve from the repo root.
DATA_DIR=./data
